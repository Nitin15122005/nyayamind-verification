# Local Python virtualenv — reinstalled from research/requirements.txt,
# never committed (5GB+, platform-specific).
research/.venv/

# Python bytecode / test caches.
**/__pycache__/
**/.pytest_cache/
*.pyc

# Claude Code local tooling config (permissions, local paths) — not part of
# the project itself.
.claude/

# Secrets / environment files — HF_TOKEN and anything else must be passed
# at runtime (see docker-compose.yml), never committed.
.env*

# Exploratory/debug pipeline runs — superseded by the curated eval_30 /
# gold_annotation artifacts kept under research/prototype/outputs/.
research/prototype/outputs/correction_search/

# Baseline run outputs — regenerated by research/baseline/scripts/run_baseline.py,
# not committed inputs.
research/baseline/outputs/

# Session scratch space.
scratchpad/

# Hugging Face cache / model weights, wherever they might land locally —
# Qwen2.5-7B-Instruct and DeBERTa-v3 are downloaded at runtime, never
# committed.
**/.cache/huggingface/
**/huggingface_cache/
