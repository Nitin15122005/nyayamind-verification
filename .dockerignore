# Local Python virtualenv — never shipped; deps are reinstalled in-image
# from research/requirements.txt.
research/.venv/
**/.venv/

# Hugging Face cache / model weights — downloaded at runtime into the
# HF_HOME volume, never baked into the image.
**/.cache/huggingface/
**/huggingface/

# Run outputs / scratch — generated artifacts, not inputs.
research/prototype/outputs/
research/baseline/outputs/
**/scratchpad/
**/scratch/

# Python/test caches.
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# VCS.
**/.git/
**/.gitignore
**/.gitattributes

# Tooling/editor config — not part of the runtime image.
.claude/
.vscode/
.idea/

# Secrets/tokens — must never be baked into the image (HF_TOKEN is passed
# at runtime via docker-compose.yml environment, not COPY'd).
**/.env
**/.env.*
**/*token*
**/*secret*
**/*.pem
**/*.key

# baseline/LegalSeg is a full checkout with its own .git; only
# research/baseline/{scripts,config} are copied into the image (see
# Dockerfile) — the rest of baseline/ and research/baseline/outputs/ are
# excluded by the rules above and by not being COPY'd at all.
baseline/LegalSeg/.git/
